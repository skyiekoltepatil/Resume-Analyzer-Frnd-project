# ==============================================================================
# Pathwise - AI Career Intelligence Environment Configuration
# ==============================================================================

# API Key (Supports OpenRouter sk-or-v1-... OR direct Google Gemini AI Studio key)
# OpenRouter: https://openrouter.ai/keys
# Google AI Studio: https://aistudio.google.com/app/apikey
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_api_key_here

# Primary Model Identifier
# When using OpenRouter: google/gemini-3.8-flash, google/gemini-2.5-flash
# When using Google direct: gemini-2.5-flash, gemini-1.5-flash, gemini-2.0-flash
GEMINI_MODEL=google/gemini-3.8-flash

# Optional Fallback Model
GEMINI_FALLBACK_MODEL=google/gemini-2.5-flash

# Job Feed Settings
# Public remote job API provider (Remotive / Arbeitnow)
ENABLE_LIVE_JOB_API=true
